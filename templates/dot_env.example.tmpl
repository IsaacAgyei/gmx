# Comma-separated browser origins allowed to call the API (defaults to http://localhost:4200)
ALLOWED_ORIGINS=http://localhost:4200
{{- if .DB}}

# Supabase project URL and the anon (public) API key. Signup and login are user-facing,
# so do not use the service_role key here.
SUPABASE_URL=
SUPABASE_KEY=
{{- end}}
{{- if .Payment}}

# Stripe secret key (use a sk_test_... key while developing; never commit it)
STRIPE_TEST_KEY=
{{- end}}
