package supabase

import (
	"fmt"
	"strings"

	"{{.Module}}/database"
)

// mapAuthError turns a Supabase Auth error into one of the database.Err* values.
// Supabase Auth reports a stable error_code (for example invalid_credentials) plus a
// message, and the client includes both in the error text, so match on either.
// Anything not recognised is returned wrapped, and the routes report it as a 502.
func mapAuthError(err error) error {
	if err == nil {
		return nil
	}
	msg := strings.ToLower(err.Error())
	has := func(subs ...string) bool {
		for _, s := range subs {
			if strings.Contains(msg, s) {
				return true
			}
		}
		return false
	}

	switch {
	case has("invalid_credentials", "invalid login credentials"):
		return database.ErrInvalidCredentials
	case has("email_not_confirmed", "email not confirmed"):
		return database.ErrEmailNotConfirmed
	case has("user_already_exists", "email_exists", "already registered", "already been registered"):
		return database.ErrUserExists
	case has("weak_password", "password should be", "password is known to be weak"):
		return database.ErrWeakPassword
	case has("over_request_rate_limit", "over_email_send_rate_limit", "rate limit"):
		return database.ErrRateLimited
	}
	return fmt.Errorf("supabase auth: %w", err)
}
