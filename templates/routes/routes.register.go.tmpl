package routes

import (
{{- if .DB}}
	"{{.Module}}/database"
{{- end}}
{{- if .Payment}}
	"{{.Module}}/paymentprocessor"
	"{{.Module}}/routes/payments"
{{- end}}
	"{{.Module}}/routes/ping"
{{- if .DB}}
	"{{.Module}}/routes/login"
	"{{.Module}}/routes/signup"
{{- end}}
	"{{.Module}}/service"

	"github.com/gin-gonic/gin"
)

type Handler struct {
{{- if .DB}}
	DB database.IDatabase // may be nil (tests); /test/db and /auth/* then report 503
{{- end}}
{{- if .Payment}}
	Pay paymentprocessor.IPaymentProcessor // may be nil (tests); payments then fail with 502
{{- end}}
}

func (h *Handler) Register(engine *gin.Engine) {
	// every service the routes use lives in the service package
	svc := service.New(service.Deps{
{{- if .DB}}
		DB: h.DB,
{{- end}}
{{- if .Payment}}
		Payment: h.Pay,
{{- end}}
	})

	// this is the parent route group, this route will be used for all child routes
	v1 := engine.Group("{{.Prefix}}")

	ping.RegisterPingRoutes(v1, svc.ServerPing{{if .DB}}, svc.DatabasePing{{end}}) // GET {{.Prefix}}/test/ping{{if .DB}}, GET {{.Prefix}}/test/db{{end}}
{{- if .DB}}
	signup.RegisterSignupRoutes(v1, svc.Signup) // POST {{.Prefix}}/auth/signup
	login.RegisterLoginRoutes(v1, svc.Login)    // POST {{.Prefix}}/auth/login
{{- end}}
{{- if .Payment}}
	payments.RegisterPaymentRoutes(v1, svc.PaymentProcessor) // POST {{.Prefix}}/payments/payment
{{- end}}
}
