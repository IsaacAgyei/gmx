package payments

import (
	"log"
	"net/http"

	"{{.Module}}/paymentprocessor"
	"{{.Module}}/service"

	"github.com/gin-gonic/gin"
)

// RegisterPaymentRoutes registers POST <group>/payments/payment with a JSON body:
// {"amount": 2000, "currency": "usd", "payment_method": "pm_card_visa", "return_url": "https://..."}
func RegisterPaymentRoutes(rg *gin.RouterGroup, paymentSvc *service.PaymentProcessorService) {
	g := rg.Group("/payments")

	g.POST("/payment", func(c *gin.Context) {
		var req paymentprocessor.PaymentRequest
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"message": "invalid request body: " + err.Error()})
			return
		}

		msg, err := paymentSvc.Payment(c.Request.Context(), req)
		if err != nil {
			log.Printf("payment failed: %v", err)
			c.JSON(http.StatusBadGateway, gin.H{"message": "Your payment could not be completed. Please try again."})
			return
		}

		c.JSON(http.StatusOK, gin.H{"message": msg})
	})
}
